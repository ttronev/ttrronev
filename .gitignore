# --- Secrets / env -------------------------------------------------------------
.env
.env.*
!.env.example

# --- Python --------------------------------------------------------------------
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/
.pytest_cache/

# --- Virtual environments ------------------------------------------------------
.venv/
venv/

# --- ttrronev runtime artifacts (not source) -----------------------------------
/logs/
/data/raw/
/data/processed/

# Keep folder structure for the gitignored runtime dirs
!/logs/.gitkeep
!/logs/trades/README.md
!/logs/errors/README.md
!/data/raw/README.md
!/data/processed/README.md

# Backtest outputs. The root path stays: three frozen scripts in detectors/
# still write there (docs/runbooks/validation_status.md, "Known paths").
/backtesting/results/
/research/backtesting/results/

# Detector / service artifacts (live on the docker volume, not in git)
/detectors/results/

# Archived runtime state (paper-trade sqlite DBs and session logs, ML model
# dumps); nothing under these paths is tracked
/archive/paper_trade/data/
/archive/paper_trade/logs/
/archive/ml_models/models/

# Claude Code local settings (machine-specific)
/.claude/

# Source pack (scripts/pack_source.ps1 output — a build artifact, not source)
/ttrronev_src.zip

# --- OS / editor ---------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/

# --- Node (only here for safety; project is Python-first) ----------------------
node_modules/

# --- OpenClaw local state ------------------------------------------------------
.openclaw_state.json
