# ttrronev — copy this file to .env and fill in your own values.
# The real .env is gitignored and must NEVER be committed (it holds live
# credentials). This template carries only placeholder keys.

# Telegram DM alerts (see detectors/alerts.py). Bot token from @BotFather;
# chat id is your numeric Telegram user/chat id. Leave blank to run without
# Telegram (the worker/alerts degrade to log-only, no error).
TTRRONEV_TG_BOT_TOKEN=
TTRRONEV_TG_CHAT_ID=

# Optional — dashboard host port for docker compose. Defaults to 8000; set it
# only on a machine where 8000 is already taken (e.g. TTRRONEV_PORT=8090).
# TTRRONEV_PORT=8000
