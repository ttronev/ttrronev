{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ttronev/ttrronev/docs/plan/stages.schema.json",
  "title": "ttrronev stage map",
  "description": "docs/plan/stages.json: the stage map as data (ТЗ-B0 §4). One entry per stage: id, name, track, depends_on, status, evidence_url, updated.",
  "type": "object",
  "additionalProperties": false,
  "required": ["updated", "source", "stages"],
  "properties": {
    "$schema": { "type": "string" },
    "updated": { "$ref": "#/$defs/date" },
    "source": { "type": "string", "minLength": 1 },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/stage" }
    }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "stageId": { "type": "string", "pattern": "^[A-Z][0-9]{1,2}[a-z]?$" },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "track", "depends_on", "status", "evidence_url", "updated"],
      "properties": {
        "id": { "$ref": "#/$defs/stageId" },
        "name": { "type": "string", "minLength": 1 },
        "track": { "type": "string", "pattern": "^[A-Z]$" },
        "depends_on": { "type": "array", "items": { "$ref": "#/$defs/stageId" }, "uniqueItems": true },
        "status": { "type": "string", "enum": ["not_started", "in_progress", "in_review", "blocked", "done"] },
        "evidence_url": { "type": ["string", "null"], "pattern": "^https://" },
        "updated": { "$ref": "#/$defs/date" }
      }
    }
  }
}
