# Keep the image small: code only. Data and results live on volumes.
.git
.venv
venv
.env
.claude
.dockerignore
Dockerfile
docker-compose*.yml

# data + generated artifacts (mounted as volumes)
data/raw
data/processed
detectors/results
logs
*.sqlite

# not needed by the service: the archive, research, tests, dev scripts and
# every doc except docs/plan (the node stage bundles docs/plan/stages.json).
# `docs/*` then `!docs/plan`: a `docs/` line would not let the plan back in.
archive
research
tests
scripts
docs/*
!docs/plan
# three frozen scripts in detectors/ still write here (validation_status.md, "Known paths")
backtesting/results

# junk
**/__pycache__
*.pyc
*.png
*.log

# frontend: the image builds frontend/dist itself in a node stage (B0a)
frontend/node_modules
frontend/dist-mock
frontend/playwright-report
frontend/test-results
frontend/dist
frontend/.vite
